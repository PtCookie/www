{
  "permissions": {
    "allow": [
      "WebFetch(domain:api.cloudflare.com)",
      "WebFetch(domain:ui.shadcn.com)",
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec astro:*)",
      "Bash(pnpm exec wrangler:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(lefthook:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "api.cloudflare.com"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "pnpm dev *",
      "pnpm test *",
      "pnpm exec wrangler *",
      "pnpm exec playwright *"
    ]
  }
}
