{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "www.ptcookie.net",
      "custom_domain": true,
    },
  ],
  // @astrojs/cloudflare splits build output into dist/client (assets) and dist/server (worker code,
  // empty for now since output stays "static" — no route has opted out of prerendering yet).
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
  },
}
