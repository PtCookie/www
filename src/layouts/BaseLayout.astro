---
import { ClientRouter } from "astro:transitions";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { config, type Locale } from "@/config.ts";
import { translate } from "@/lib/utils.ts";
import packageJson from "../../package.json";
import "@/styles/global.css";

interface Props {
  lang?: Locale;
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  wide?: boolean;
}

const { lang, wide } = Astro.props;
const locale = lang ?? config.defaultLocale;
const title = [Astro.props.title, config.title].filter(Boolean).join(" | ");
const description = Astro.props.description || config.description;
const ogType = Astro.props.ogType ?? (Astro.props.description ? "article" : "website");
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang ?? config.defaultLocale}>
  <head>
    <!--Base-->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <!--Favicon-->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!--Theme (content kept in sync with src/lib/theme.ts's applyTheme via the script below)-->
    <meta name="theme-color" id="theme-color-meta" content="oklch(1 0 0)" />
    <script is:inline data-theme-init>
      {
        // Must stay `is:inline` plain JS with no imports: a bundled `<script>` becomes a
        // deferred `type="module"` in a separate file and flashes light on every load for dark
        // users. This resolve expression intentionally duplicates src/lib/theme.ts's applyTheme
        // — that module can't be imported here without losing is:inline. The outer `{ ... }`
        // block keeps the declarations out of global scope.
        //
        // astro:after-swap re-runs this because Astro's ClientRouter swap
        // (swapRootAttributes in astro/dist/transitions/swap-functions.js) replaces <html>'s
        // entire attribute set with the incoming (theme-less) SSR document's, dropping
        // data-theme/class every navigation. data-astro-rerun is not a substitute: rerun
        // scripts execute in runScripts(), which fires after the view transition's
        // updateCallbackDone resolves — i.e. after paint — so it would flash then correct.
        const THEME_COLOR = { light: "oklch(1 0 0)", dark: "oklch(0.148 0.004 228.8)" };

        function applyStoredTheme() {
          let pref = "system";
          try {
            const stored = localStorage.getItem("theme");
            if (stored === "system" || stored === "light" || stored === "dark") pref = stored;
          } catch {
            // localStorage throws outright when storage is disabled or partitioned (private
            // mode, some embedded webviews) — fall back to the OS preference.
          }
          const isDark = pref === "dark" || (pref === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = pref;
          document.documentElement.classList.toggle("dark", isDark);
          document
            .getElementById("theme-color-meta")
            ?.setAttribute("content", isDark ? THEME_COLOR.dark : THEME_COLOR.light);
        }

        applyStoredTheme();
        document.addEventListener("astro:after-swap", applyStoredTheme);
      }
    </script>
    <!--Metadata-->
    <link rel="canonical" href={pageUrl} />
    <meta name="description" content={description} />
    <meta name="author" content={packageJson.author.name} />
    <meta name="generator" content={Astro.generator} />
    <!--Open Graph-->
    <meta property="og:title" content={title} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:description" content={description} />
    <!--Twitter Cards-->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content="/x.png" />
    <meta property="twitter:image:width" content="1200" />
    <meta property="twitter:image:height" content="675" />
    <meta property="twitter:image:alt" content={title} />
    <!--Astro view transition-->
    <ClientRouter />
    <!--Hide JS-only controls (theme/locale toggles) when JS is unavailable, instead of shipping a dead button-->
    <noscript>
      <style>
        [data-js-only] {
          display: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="focus:bg-background focus:text-foreground sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:px-4 focus:py-2 focus:shadow-lg"
    >
      {translate(locale, "component.skipToContent")}
    </a>
    <Header lang={lang} />
    <main
      id="main"
      class:list={["mx-auto flex w-full max-w-5/6 grow flex-col sm:px-8", wide ? "sm:max-w-5xl" : "sm:max-w-3xl"]}
    >
      <slot />
    </main>
    <Footer />


  </body>
</html>
