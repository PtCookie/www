---
import type { Page } from "astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { Pagination } from "@/components/Pagination.tsx";
import { PostCard } from "@/components/PostCard.tsx";

interface Props {
  title: string;
  basePath: string;
  page: Page<CollectionEntry<"post">>;
}

const { title, basePath, page } = Astro.props;
---

<h1 class="mt-8 mb-12 text-center text-4xl font-extrabold sm:text-5xl">{title}</h1>
<div class="grid flex-1 place-items-center content-start gap-8">
  {
    page.data.map((post) => (
      <PostCard post={post.data}>
        <Image
          src={post.data.coverImage.url}
          inferSize={true}
          alt={post.data.title}
          class="h-full w-full overflow-hidden rounded-t-xl object-cover"
        />
      </PostCard>
    ))
  }
</div>
{
  Math.ceil(page.total / page.size) > 1 && (
    <div class="mt-8">
      <Pagination
        total={Math.ceil(page.total / page.size)}
        currentPage={page.currentPage}
        basePath={basePath}
        display={3}
        prev={page.url.prev}
        next={page.url.next}
      />
    </div>
  )
}
