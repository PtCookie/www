---
import { Image } from "emdash/ui";

import { Pagination } from "@/components/Pagination.tsx";
import { PostCard } from "@/components/PostCard.tsx";
import type { PagedItems } from "@/lib/pagination.ts";
import type { PostView } from "@/lib/post.ts";
import type { Locale } from "@/config.ts";

interface Props {
  title: string;
  basePath: string;
  page: PagedItems<PostView>;
  lang?: Locale;
}

const { title, basePath, page, lang } = Astro.props;
---

<h1 class="mt-8 mb-12 text-center text-4xl font-extrabold sm:text-5xl">{title}</h1>
<div class="grid flex-1 place-items-center content-start gap-8">
  {
    page.items.map((post) => (
      <PostCard post={post} lang={lang}>
        <Image image={post.coverImage.image} class="h-full w-full overflow-hidden rounded-t-xl object-cover" />
      </PostCard>
    ))
  }
</div>
{
  page.totalPages > 1 && (
    <div class="mt-8">
      <Pagination
        total={page.totalPages}
        currentPage={page.currentPage}
        basePath={basePath}
        display={3}
        prev={page.prevUrl}
        next={page.nextUrl}
      />
    </div>
  )
}
