---
import Logo from "@/assets/logo.svg";

const text = "PtCookie.Net";
---

<div id="intro" class="mb-16 flex flex-col items-center justify-center gap-16">
  <div id="intro-coin" class="h-48 w-48 origin-center transform-3d sm:h-64 sm:w-64">
    <Logo class="h-full w-full rounded-full shadow-2xl" role="img" aria-label="PtCookie" />
  </div>
  <div class="font-mono text-4xl font-bold drop-shadow-lg text-shadow-lg sm:text-6xl" translate="no">
    <span aria-hidden="true">
      {text.split("").map((char) => <span class="char inline-block">{char}</span>)}
    </span>
    <span class="sr-only">{text}</span>
  </div>
</div>

<script>
  import { gsap } from "gsap";

  let ctx: gsap.Context | undefined;

  document.addEventListener("astro:page-load", () => {
    const container = document.getElementById("intro");
    if (!container) return;

    // Re-entering this page via ClientRouter re-runs this listener without a full reload, so
    // any previous run's timeline must be torn down first — this timeline is `repeat: -1`,
    // and without `revert()` each visit would start another infinite timeline on top of the
    // last (a compounding CPU leak `useGSAP`'s unmount cleanup used to prevent for free).
    ctx?.revert();

    // Respect the user's motion preference: leave the coin and text in their static, at-rest
    // state instead of running the (repeat: -1) flip/typing timeline.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    ctx = gsap.context(() => {
      const mainTimeline = gsap.timeline({ repeat: -1, repeatDelay: 1 });

      const flipTimeline = gsap.timeline();
      const typingTimeline = gsap.timeline();

      mainTimeline.add([flipTimeline, typingTimeline], 0);

      flipTimeline
        .set("#intro-coin", { rotationY: 0 })
        .to("#intro-coin", { rotationY: 180, duration: 1.75, ease: "power2.in" })
        .to("#intro-coin", { rotationY: 360, duration: 1.25, ease: "power2.out" });

      typingTimeline.to(".char", {
        y: -30,
        ease: "power2.out",
        stagger: {
          each: 0.15,
          repeat: 1,
        },
        yoyo: true,
        yoyoEase: "bounce.out",
      });
    }, container);
  });

  document.addEventListener("astro:before-swap", () => ctx?.revert());
</script>
