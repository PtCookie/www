---
import { Navigation } from "./Navigation.tsx";
import { ModeToggle } from "./ModeToggle.tsx";
import { LangToggle } from "./LangToggle.tsx";
import { config, type Locale } from "@/config.ts";

interface Props {
  lang?: Locale;
}

const { lang } = Astro.props;
const { title, menuEntry } = config;
const localizedEntry = menuEntry.map((entry) => ({ ...entry, link: `/${lang}${entry.link}` }));
const currentUrl = Astro.url.pathname;
---

<header class="mx-auto my-1.5 flex w-full max-w-3xl justify-between border-b-2 px-8 py-2 sm:my-6">
  <div class="flex items-center">
    <a class="font-mono text-xl leading-tight font-bold italic sm:text-3xl" href={`/${lang}`}>{title}</a>
  </div>
  <div class="flex items-center">
    <Navigation menuEntry={lang ? localizedEntry : menuEntry} />
    <ModeToggle lang={lang} client:load />
    <LangToggle lang={lang} currentUrl={currentUrl} client:load />
  </div>
</header>

<script>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  }

  document.addEventListener("astro:after-swap", () => {
    if (localStorage.theme === "dark") {
      document.documentElement.classList.add("dark");
    }
  });
</script>
