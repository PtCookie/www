---
import { Navigation } from "./Navigation.tsx";
import { ModeToggle } from "./ModeToggle.tsx";
import { LangToggle } from "./LangToggle.tsx";
import { Hamburger } from "./Hamburger.tsx";
import { config, type Locale } from "@/config.ts";

interface Props {
  lang?: Locale;
}

const { lang } = Astro.props;
const { title, menuEntry, linkEntry } = config;
const localizedEntry = lang ? menuEntry.map((entry) => ({ ...entry, link: `/${lang}${entry.link}` })) : menuEntry;
const currentUrl = Astro.url.pathname;
---

<header class="mx-auto my-1.5 flex w-full justify-center border-b-2 px-8 py-2 sm:my-6 sm:py-4">
  <div class="flex w-full max-w-3xl items-center justify-between sm:max-w-5xl">
    <div class="flex items-center">
      <a class="font-serif text-xl font-bold sm:text-3xl sm:leading-tight" href={`/${lang}`}>{title}</a>
    </div>
    <div class="hidden items-center sm:flex">
      <Navigation menuEntry={localizedEntry} linkEntry={linkEntry} client:load />
      <ModeToggle lang={lang} client:load />
      <LangToggle lang={lang} currentUrl={currentUrl} client:load />
    </div>
    <div class="flex items-center sm:hidden">
      <Hamburger lang={lang} menuEntry={localizedEntry} linkEntry={linkEntry} currentUrl={currentUrl} client:load />
    </div>
  </div>
</header>

<script>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  }

  document.addEventListener("astro:after-swap", () => {
    if (localStorage.theme === "dark") {
      document.documentElement.classList.add("dark");
    }

    // A Radix Sheet/Dialog left open during a ClientRouter swap can leave <body> inert
    // (react-remove-scroll's overflow lock, Radix's pointer-events lock) if its own React
    // cleanup never gets to run. Clear those out defensively after every page swap.
    document.body.style.removeProperty("pointer-events");
    document.body.style.removeProperty("overflow");
    document.body.removeAttribute("data-scroll-locked");
  });
</script>
