---
import { type MenuEntry, Navigation } from "./Navigation";

const title = "Title";
const menuEntry: Array<MenuEntry> = [
  { name: "Home", link: "/" },
  { name: "Posts", link: "/posts" },
  { name: "Tags", link: "/tags" },
];
---

<header class="mx-auto my-4 flex w-full max-w-3xl justify-between border-b-2 px-4 py-2 sm:my-6">
  <a class="font-sans text-2xl leading-tight font-medium sm:text-4xl" href="/">{title}</a>
  <Navigation menuEntry={menuEntry} />
</header>
