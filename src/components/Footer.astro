---
const from = 2021;
const year = [from, new Date().getFullYear()].join("-");
const author = "PtCookie";
const credit = [year, author].join(", ");
---

<footer class="mx-auto flex w-full max-w-3xl flex-col gap-4 border-t-2 pt-4 pb-6 sm:pt-8 sm:pb-12">
  <p class="text-center text-gray-500">
    Built with {Astro.generator}
  </p>
  <p class="text-center text-gray-500">
    &copy; {credit}
  </p>
</footer>
