---
import { config } from "@/config.ts";

const { author, copyrightFrom } = config;

const year = [copyrightFrom, new Date().getFullYear()].join("-");
const credit = [year, author].join(", ");
---

<footer
  class="text-muted-foreground mx-auto my-6 flex w-full max-w-3xl flex-col gap-4 border-t-2 py-4 text-center font-sans text-sm sm:py-8 sm:text-base"
>
  <p>Built with {Astro.generator}</p>
  <p>&copy; {credit}</p>
</footer>
