---
import { config } from "@/config.ts";
import packageJson from "../../package.json";

const { copyrightFrom } = config;

const year = [copyrightFrom, new Date().getFullYear()].join("-");
const credit = [year, packageJson.author.name].join(", ");
---

<footer
  class="text-muted-foreground mx-auto my-6 flex w-full max-w-3xl flex-col gap-4 border-t-2 py-4 text-center font-sans text-sm sm:max-w-5xl sm:py-6 sm:text-lg"
>
  <p translate="no">Built with {Astro.generator}</p>
  <p translate="no">&copy; {credit}</p>
</footer>
