---
import { config } from "@/config.ts";
import packageJson from "../../package.json";

const { copyrightFrom, linkEntry } = config;

const year = [copyrightFrom, new Date().getFullYear()].join("-");
const credit = [year, packageJson.author.name].join(", ");
---

<footer
  class="text-muted-foreground mx-auto my-6 flex w-full max-w-3xl flex-col gap-4 border-t-2 py-4 text-center font-sans text-sm sm:max-w-5xl sm:py-6"
>
  {
    linkEntry.length > 0 && (
      <ul role="list" class="flex flex-wrap items-center justify-center gap-4">
        {linkEntry.map((item) => (
          <li>
            <a href={item.link} target="_blank" rel="noreferrer" class="hover:text-foreground hover:underline">
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <p translate="no">Built with {Astro.generator}</p>
  <p translate="no">&copy; {credit}</p>
</footer>
