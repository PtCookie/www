---
import { buttonVariants } from "@/components/ui/button.tsx";
import { cn, translate } from "@/lib/utils.ts";
import type { Locale } from "@/config.ts";

interface Props {
  lang: Locale;
  class?: string;
  button?: boolean;
}

const { lang, class: className, button = false } = Astro.props;
---

<div class={cn("flex flex-col items-center justify-center gap-8 text-center", className)}>
  <div class="text-6xl sm:text-8xl">&#x1F6A7;</div>
  <h2 class="text-4xl font-bold">{translate(lang, "page.underConstruction")}</h2>
  {
    button && (
      <a href={`/${lang}`} class={cn(buttonVariants({ variant: "secondary" }), "p-6 text-xl sm:mt-2")}>
        {translate(lang, "page.returnHome")}
      </a>
    )
  }
</div>
