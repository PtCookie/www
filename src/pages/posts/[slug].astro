---
import { getCollection } from "astro:content";
import { Markdown } from "@astropub/md";

import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("post");

  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.subtitle}>
  <img src={post.data.coverImage.url} alt={post.data.title} />

  <h1>{post.data.title}</h1>
  <p>{post.data.readTimeInMinutes} min read</p>

  <div class="prose sm:prose-lg max-w-none">
    <Markdown of={post.data.content.markdown} />
  </div>
</BaseLayout>
