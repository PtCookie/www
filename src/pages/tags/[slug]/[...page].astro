---
import type { GetStaticPathsOptions } from "astro";
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { getAllTags } from "@/lib/utils.ts";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("post");
  const allTags = getAllTags(posts, true);

  return allTags.flatMap((tag) => {
    const filteredPosts = posts.filter((post) => post.data.tags.some((t) => t.name === tag.name));

    return paginate(filteredPosts, {
      params: { slug: tag.slug },
      props: { tag },
      pageSize: 3,
    });
  });
}

const { tag, page } = Astro.props;
---

<BaseLayout title={tag.name}>
  <PostList title={tag.name} basePath={`/tags/${tag.slug}`} page={page} />
</BaseLayout>
