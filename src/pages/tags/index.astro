---
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllTags } from "@/lib/utils.ts";
import { badgeVariants } from "@/components/ui/badge.tsx";

const posts = await getCollection("post");
const allTags = getAllTags(posts, true);
---

<BaseLayout title="Tags">
  <h1 class="mt-8 mb-12 text-center text-5xl font-extrabold">Tags</h1>
  <div class="grid flex-1 place-items-start content-start gap-8 px-8">
    {
      allTags.map((tag) => (
        <div>
          <a
            href={`/tags/${tag.slug}`}
            data-testid="badge"
            class:list={[badgeVariants({ variant: "secondary" }), "font-mono"]}
          >
            #{tag.name}
          </a>
          <p class="mt-2 pl-4">{tag.count} posts</p>
        </div>
      ))
    }
  </div>
</BaseLayout>
