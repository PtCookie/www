---
// Not prerendered (unlike the other purely static pages): Astro.rewrite("/404"), used by every
// SSR post/tag route to render a real 404 for a bad slug/page/locale, can't target a prerendered
// route at runtime — the component is compiled straight to an HTML file during build and isn't
// retrievable as a live component instance afterward ("Unexpectedly unable to find a component
// instance for route /404"). Astro's built-in "no route matched" handling still finds this file
// automatically by its reserved filename regardless of prerender status.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button.tsx";
import { translate } from "@/lib/utils.ts";
import { config, isLocale } from "@/config.ts";

// This route has no `lang` param of its own, so the locale is recovered from the path the visitor
// actually asked for. Astro.originPathname is that path — the pathname *before* rewrites — and it
// survives both ways this page is reached:
//   Astro.rewrite("/404") from the SSR index/post/tag routes, where Astro.url is only "/404"
//     (astro/dist/core/rewrites/handler.js hands the pre-rewrite pathname to setOriginPathname)
//   Astro's own "no route matched" fallback, which builds the render context from the original
//     request (astro/dist/core/errors/default-handler.js)
// A first segment that isn't a locale falls back to the default — which covers both a bare
// unprefixed path and the !isLocale(lang) guards that rewrite here with a bogus locale.
const [, maybeLocale] = Astro.originPathname.split("/");
const lang = isLocale(maybeLocale) ? maybeLocale : config.defaultLocale;
---

<BaseLayout lang={lang} title={translate(lang, "page.notFound")}>
  <div class="flex grow flex-col items-center justify-center gap-8">
    <h1 class="text-2xl">{translate(lang, "page.notFound")}</h1>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href={`/${lang}`} class={buttonVariants()}>
        {translate(lang, "page.returnHome")}
      </a>
      <a href={`/${lang}/posts`} class={buttonVariants({ variant: "secondary" })}>
        {translate(lang, "page.allPosts")}
      </a>
      <a href={`/${lang}/tags`} class={buttonVariants({ variant: "secondary" })}>
        {translate(lang, "page.allTags")}
      </a>
    </div>
  </div>
</BaseLayout>
