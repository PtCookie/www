---
export const prerender = true;
import { compareDesc, parseISO } from "date-fns";
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import Intro from "@/components/Intro.astro";
import { PostCard } from "@/components/PostCard.tsx";
import { translate } from "@/lib/utils.ts";
import { config } from "@/config.ts";

export async function getStaticPaths() {
  return config.locales.map((locale) => ({ params: { lang: locale } }));
}

const { lang } = Astro.params;
const posts = (await getCollection("post", ({ data }) => data.locale === lang))
  .sort((a, b) => compareDesc(parseISO(a.data.publishedAt), parseISO(b.data.publishedAt)))
  .slice(0, 3);
---

<BaseLayout lang={lang} wide>
  <h1 class="sr-only">{config.title}</h1>
  <div class="grid flex-1 place-items-center content-start gap-8 py-8">
    <Intro />
    <h2 class="text-center text-2xl font-medium sm:text-3xl">{translate(lang, "page.recentPosts")}</h2>
    {posts.map((post) => <PostCard post={post.data} lang={lang} disableImage={true} headingLevel="h3" />)}
    <a href={`/${lang}/posts`} class="text-primary font-sans text-lg font-medium hover:underline sm:text-xl">
      {translate(lang, "page.viewAll")}
    </a>
  </div>
</BaseLayout>
