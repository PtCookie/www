---
export const prerender = true;
import { getImage } from "astro:assets";

import BaseLayout from "@/layouts/BaseLayout.astro";
import profileJpg from "@/assets/profile.jpg";
import profilePng from "@/assets/profile.png";
import { translate } from "@/lib/utils.ts";
import { config } from "@/config.ts";

export async function getStaticPaths() {
  return config.locales.map((locale) => ({ params: { lang: locale } }));
}

const { lang } = Astro.params;

// Both variants used to render as two <Image>s, one hidden with `hidden sm:block` / `sm:hidden`
// — CSS display:none doesn't stop the download, so every visitor paid for both. A native
// <picture> with a <source media> only ever fetches the one it picks. Built at request time via
// getImage() (this page is prerendered, so that's still build time) rather than <Image>, since
// <picture>'s <source srcset> needs a plain string, not the component.
const desktopProfile = await getImage({ src: profileJpg, width: 768, height: 768 });
const mobileProfile = await getImage({ src: profilePng, width: 512, height: 512 });

// Page-scoped content, not shared elsewhere — doesn't belong in config.ts.
const techEntry = [
  { name: "React.js", href: "https://react.dev/", src: "/logos/react.svg" },
  { name: "GraphQL", href: "https://graphql.org/", src: "/logos/graphql.svg" },
  { name: "Electron", href: "https://www.electronjs.org/", src: "/logos/electron.svg" },
  { name: "TypeScript", href: "https://www.typescriptlang.org/", src: "/logos/typescript.svg" },
  { name: "Node.js", href: "https://nodejs.org/", src: "/logos/nodejs.svg" },
];
---

<BaseLayout
  lang={lang}
  title={translate(lang, "page.about")}
  description={translate(lang, "page.aboutDescription")}
  ogType="website"
  wide
>
  <div class="grid grow items-center justify-items-center">
    <div class="flex flex-col items-center justify-between gap-12 py-12 text-center sm:flex-row sm:py-0">
      <div class="flex max-w-2/5 flex-col items-center justify-center overflow-hidden rounded-full sm:rounded-4xl">
        {
          /*
            Explicit width+height (not width-only) so Sharp crops to this box instead of
            preserving the source's true aspect ratio — profile.jpg is a portrait photo once
            its EXIF rotation is applied (1836x3264), not the landscape headshot the rounded
            avatar container expects. `object-cover` fills the box without distorting it.
          */
        }
        <picture>
          <source media="(min-width: 640px)" srcset={desktopProfile.src} width="768" height="768" />
          <img src={mobileProfile.src} alt="Profile" width={512} height={512} class="h-full w-full object-cover" />
        </picture>
      </div>
      <div class="flex flex-col items-center justify-center gap-8 text-center">
        <h1 class="max-w-3/5 font-sans text-4xl leading-tight font-black text-balance sm:max-w-full sm:text-6xl">
          {translate(lang, "page.greeting")}
          <br />
          {translate(lang, "page.name")}
        </h1>
        <h2 class="mb-8 max-w-4/5 font-sans text-xl leading-normal font-semibold sm:text-3xl">
          {translate(lang, "page.career")}
        </h2>
        <p class="font-mono text-base leading-normal font-semibold sm:max-w-4/5 sm:text-xl">
          {translate(lang, "page.techIntro")}
        </p>
        {
          /* flex-wrap + justify-center centers every row including the trailing one, instead of
             a fixed-column grid that leaves an orphaned partial row pinned to the start. A
             visible label under each mark is needed since an unfamiliar logo with only `alt`
             text is unidentifiable at a glance. */
        }
        <div class="mt-8 flex flex-wrap items-start justify-center gap-8">
          {
            techEntry.map((tech) => (
              <a href={tech.href} target="_blank" rel="noreferrer" class="flex flex-col items-center gap-2">
                <img
                  src={tech.src}
                  alt=""
                  width={128}
                  height={128}
                  loading="lazy"
                  decoding="async"
                  class="w-24 sm:w-32"
                />
                <span class="text-muted-foreground font-mono text-xs sm:text-sm">{tech.name}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
