---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import { compareDesc, parseISO } from "date-fns";

import BaseLayout from "@/layouts/BaseLayout.astro";
import { badgeVariants } from "@/components/ui/badge.tsx";
import { PostCard } from "@/components/PostCard.tsx";
import { formatDate, translate } from "@/lib/utils.ts";
import { config } from "@/config.ts";

export async function getStaticPaths() {
  const posts = await getCollection("post");

  return config.locales.flatMap((locale) => {
    const localePosts = posts
      .filter((post) => post.data.locale === locale)
      .sort((a, b) => compareDesc(parseISO(a.data.publishedAt), parseISO(b.data.publishedAt)));

    return localePosts.map((post, index) => {
      return {
        params: { lang: locale, slug: post.data.slug },
        props: {
          post,
          // Posts are sorted newest-first, so the "next" post to read is the one published before it.
          prevPost: index + 1 < localePosts.length ? localePosts[index + 1] : null,
          nextPost: index > 0 ? localePosts[index - 1] : null,
        },
      };
    });
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { lang } = Astro.params;
const { Content } = await render(post);
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.subtitle}>
  <h1 class="my-4 text-3xl font-extrabold sm:my-8 sm:text-5xl">{post.data.title}</h1>
  <p class="mb-3 text-xl font-semibold sm:mb-4 sm:text-2xl">{post.data.subtitle}</p>
  <div class="text-muted-foreground mb-2 flex justify-between font-sans text-xs tabular-nums sm:text-sm">
    <p>
      <time datetime={post.data.publishedAt}>{formatDate(lang, post.data.publishedAt)}</time>
    </p>
    <p>{post.data.readTimeInMinutes}{translate(lang, "component.readTime")}</p>
  </div>
  <div class="flex flex-wrap justify-end gap-2">
    {
      post.data.tags.map((tag) => (
        <a
          href={`/${lang}/tags/${tag.slug}`}
          data-testid="badge"
          class:list={[badgeVariants({ variant: "secondary" }), "font-mono"]}
        >
          #{tag.name}
        </a>
      ))
    }
  </div>

  {
    post.data.coverImage.url && (
      <figure class="relative mt-4 mb-8 sm:mt-6 sm:mb-10">
        <Image
          src={post.data.coverImage.url}
          alt={post.data.title}
          loading="eager"
          fetchpriority="high"
          class="rounded-md"
        />
        {post.data.coverImage.photographer && post.data.coverImage.attribution && (
          <figcaption class="bg-muted absolute right-2 bottom-2 rounded-sm px-2.5 py-1 text-xs italic sm:right-4 sm:bottom-4 sm:text-sm">
            Photo by&nbsp;
            <a href={post.data.coverImage.attribution} target="_blank" rel="noreferrer" class="underline">
              {post.data.coverImage.photographer}
            </a>
          </figcaption>
        )}
      </figure>
    )
  }

  <article
    class:list={[
      "prose sm:prose-lg dark:prose-invert prose-p:font-serif max-w-none",
      post.data.coverImage.url || "my-8",
    ]}
  >
    <Content />
  </article>

  <div class="my-6 flex flex-wrap justify-start gap-2 sm:my-8">
    {
      post.data.tags.map((tag) => (
        <a
          href={`/${lang}/tags/${tag.slug}`}
          data-testid="badge"
          class:list={[badgeVariants({ variant: "secondary" }), "font-mono"]}
        >
          #{tag.name}
        </a>
      ))
    }
  </div>

  {
    (prevPost || nextPost) && (
      <Fragment>
        <h2 class="text-center text-lg font-medium sm:mb-4 sm:text-xl">{translate(lang, "page.readNext")}</h2>
        <div class="my-4 grid flex-1 place-items-center content-center gap-8">
          {nextPost && <PostCard post={nextPost.data} lang={lang} disableImage={true} headingLevel="h3" />}
          {prevPost && <PostCard post={prevPost.data} lang={lang} disableImage={true} headingLevel="h3" />}
        </div>
      </Fragment>
    )
  }
</BaseLayout>
