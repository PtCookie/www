---
import type { GetStaticPathsOptions } from "astro";
import { getCollection } from "astro:content";

import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { translate } from "@/lib/utils.ts";
import { config } from "@/config.ts";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("post");

  return config.locales.flatMap((locale) => {
    const filteredPosts = posts.filter((post) => post.data.locale === locale);

    return paginate(filteredPosts, {
      params: { lang: locale },
      pageSize: 3,
    });
  });
}

const { page } = Astro.props;
const { lang } = Astro.params;
---

<BaseLayout lang={lang} title={translate(lang, "page.allPosts")}>
  <PostList title={translate(lang, "page.allPosts")} basePath={`/${lang}/posts`} page={page} lang={lang} />
</BaseLayout>
