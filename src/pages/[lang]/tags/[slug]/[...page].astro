---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import { paginate } from "@/lib/pagination.ts";
import { toPostView } from "@/lib/post.ts";
import { getAllPublishedPosts } from "@/lib/posts.ts";
import { isLocale } from "@/config.ts";

const { lang, slug, page: pageParam } = Astro.params;
if (!isLocale(lang) || !slug) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const PAGE_SIZE = 3;
const pageNumber = pageParam === undefined ? 1 : /^\d+$/.test(pageParam) ? Number(pageParam) : NaN;

const taggedPosts = (await getAllPublishedPosts(lang, slug)).map(toPostView);
const tagName = taggedPosts[0]?.tags.find((tag) => tag.slug === slug)?.name;
const page = tagName ? paginate(taggedPosts, pageNumber, PAGE_SIZE, `/${lang}/tags/${slug}`) : null;

if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}
---

<BaseLayout lang={lang} title={tagName}>
  <PostList title={tagName} basePath={`/${lang}/tags/${slug}`} page={page} lang={lang} />
</BaseLayout>
