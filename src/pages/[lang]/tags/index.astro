---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { badgeVariants } from "@/components/ui/badge.tsx";
import { getAllTags, translate } from "@/lib/utils.ts";
import { toPostView } from "@/lib/post.ts";
import { getAllPublishedPosts } from "@/lib/posts.ts";
import { isLocale } from "@/config.ts";

const { lang } = Astro.params;
if (!isLocale(lang)) {
  Astro.response.status = 404;
  return Astro.rewrite("/404");
}

const posts = (await getAllPublishedPosts(lang)).map((entry) => ({ data: toPostView(entry) }));
const allTags = getAllTags(posts, true);
---

<BaseLayout lang={lang} title={translate(lang, "page.allTags")}>
  <h1 class="mt-8 mb-12 text-center text-5xl font-extrabold">{translate(lang, "page.allTags")}</h1>
  <div class="grid flex-1 place-items-start content-start gap-8 px-8">
    {
      allTags.map((tag) => (
        <div>
          <a
            href={`/${lang}/tags/${tag.slug}`}
            data-testid="badge"
            class:list={[badgeVariants({ variant: "secondary" }), "font-mono"]}
          >
            #{tag.name}
          </a>
          <p class="mt-2 pl-4">
            {tag.count} {translate(lang, "page.posts")}
          </p>
        </div>
      ))
    }
  </div>
</BaseLayout>
