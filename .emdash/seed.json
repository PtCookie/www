{
    "$schema": "https://emdashcms.com/seed.schema.json",
    "version": "1",
    "defaultLocale": "ko",
    "meta": {
        "name": "ptcookie.net",
        "description": "Bilingual blog content model for www.ptcookie.net"
    },
    "settings": {
        "title": "PtCookie.Net",
        "tagline": "Personal blog of PtCookie.Net"
    },
    "collections": [
        {
            "slug": "posts",
            "label": "Posts",
            "labelSingular": "Post",
            "description": "Blog posts, one row per locale (translations link via the admin's Translations panel).",
            "icon": "file-text",
            "supports": ["drafts", "revisions", "search"],
            "fields": [
                {
                    "slug": "title",
                    "label": "Title",
                    "type": "string",
                    "required": true,
                    "searchable": true
                },
                {
                    "slug": "subtitle",
                    "label": "Subtitle",
                    "type": "string",
                    "required": true,
                    "searchable": true
                },
                {
                    "slug": "excerpt",
                    "label": "Excerpt",
                    "type": "text",
                    "required": true
                },
                {
                    "slug": "content",
                    "label": "Content",
                    "type": "portableText",
                    "required": true,
                    "searchable": true
                },
                {
                    "slug": "cover_image",
                    "label": "Cover Image",
                    "type": "image"
                },
                {
                    "slug": "cover_attribution",
                    "label": "Cover Attribution URL",
                    "type": "url"
                },
                {
                    "slug": "cover_photographer",
                    "label": "Cover Photographer",
                    "type": "string"
                }
            ]
        }
    ],
    "taxonomies": [
        {
            "id": "tax:tag:ko",
            "name": "tag",
            "label": "Tags",
            "labelSingular": "Tag",
            "hierarchical": false,
            "collections": ["posts"],
            "locale": "ko",
            "terms": [
                { "id": "term:tag:typescript:ko", "slug": "typescript", "label": "typescript" },
                { "id": "term:tag:shell:ko", "slug": "shell", "label": "shell" },
                { "id": "term:tag:reactjs:ko", "slug": "reactjs", "label": "reactjs" },
                { "id": "term:tag:nodejs:ko", "slug": "nodejs", "label": "nodejs" },
                { "id": "term:tag:nextjs:ko", "slug": "nextjs", "label": "nextjs" },
                { "id": "term:tag:electron:ko", "slug": "electron", "label": "electron" },
                { "id": "term:tag:css:ko", "slug": "css", "label": "css" },
                {
                    "id": "term:tag:typescript:en",
                    "slug": "typescript",
                    "label": "typescript",
                    "locale": "en",
                    "translationOf": "term:tag:typescript:ko"
                },
                {
                    "id": "term:tag:shell:en",
                    "slug": "shell",
                    "label": "shell",
                    "locale": "en",
                    "translationOf": "term:tag:shell:ko"
                },
                {
                    "id": "term:tag:reactjs:en",
                    "slug": "reactjs",
                    "label": "reactjs",
                    "locale": "en",
                    "translationOf": "term:tag:reactjs:ko"
                },
                {
                    "id": "term:tag:nodejs:en",
                    "slug": "nodejs",
                    "label": "nodejs",
                    "locale": "en",
                    "translationOf": "term:tag:nodejs:ko"
                },
                {
                    "id": "term:tag:nextjs:en",
                    "slug": "nextjs",
                    "label": "nextjs",
                    "locale": "en",
                    "translationOf": "term:tag:nextjs:ko"
                },
                {
                    "id": "term:tag:electron:en",
                    "slug": "electron",
                    "label": "electron",
                    "locale": "en",
                    "translationOf": "term:tag:electron:ko"
                },
                {
                    "id": "term:tag:css:en",
                    "slug": "css",
                    "label": "css",
                    "locale": "en",
                    "translationOf": "term:tag:css:ko"
                }
            ]
        }
    ],
    "content": {
        "posts": [
            {
                "id": "post:sample:ko",
                "slug": "hello-emdash",
                "status": "published",
                "taxonomies": { "tag": ["typescript", "shell"] },
                "data": {
                    "title": "EmDash로 시작하는 블로그",
                    "subtitle": "시드 데이터로 만든 샘플 게시물",
                    "excerpt": "이 글은 빈 데이터베이스에서도 블로그 목록과 태그를 확인할 수 있도록 시드 파일이 채워 넣은 샘플 게시물입니다.",
                    "content": [
                        {
                            "_type": "block",
                            "style": "normal",
                            "markDefs": [],
                            "children": [
                                {
                                    "_type": "span",
                                    "text": "이 글은 .emdash/seed.json의 샘플 콘텐츠로 생성되었습니다.",
                                    "marks": []
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    }
}
